{
  "manifest_version": 3,
  "name": "Airbnb Host Rate Exporter",
  "description": "Export nightly rates from Airbnb host calendar year view to CSV.",
  "version": "0.2.2",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export Airbnb rates",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.airbnb.com/*",
        "https://*.airbnb.com/*"
      ],
      "js": [
        "src/shared.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://www.airbnb.com/*",
    "https://*.airbnb.com/*"
  ]
}
